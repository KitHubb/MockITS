nextflow.enable.dsl = 2

/*
 * ITSdetector local high-memory profile
 * Server target: ~101 CPU cores, ~1 TB RAM
 * Practical cap: ~70 CPU cores and ~700 GB RAM
 */

params {
    input = null
    outdir = 'results'

    run_label = 'production'

    /*
     * Container paths
     */
    qc_sif = '/data/software/singularity/qc_fastqc_multiqc.sif'
    cutadapt_sif = '/data/software/singularity/read_cleanup_cutadapt-5.2.sif'
    qiime_sif = '/data/software/singularity/qiime2_amplicon_2025.7.sif'
    qiime_its_sif = '/data/software/singularity/build/qiime2_its_2025.7.sandbox'
    blast_taxonomy_sif = '/data/software/singularity/itsdetector/blast_taxonomy_2026-06.sif'

    /*
     * Reference database paths
     */
    taxonomy_reference_id = 'unite_ver10_99'
    taxonomy_classifier = '/data/Reference/QIIME2-2024.10/Fungi/UNITE/10.0/unite_ver10_99_19.02.2025-Q2-2024.10.qza'
    blast_db = '/data/Reference/BLAST/ITS/20250604/ITS_RefSeq_Fungi'
    taxdump_dir = '/data/Reference/BLAST/taxdump'

    /*
     * Safe defaults. Benchmark-specific values should be overridden by params/*.yml.
     */
    adapter_trim = true
    adapter_f = 'CTGTCTCTTATACACATCTCCGAGCCCACGAGAC'
    adapter_r = 'CTGTCTTATACACATCTGACGCTGCCGACGA'

    poly_g_trim = true
    poly_g_min_run = 10

    quality_trim = false
    quality_cutoff = 20

    apply_min_length = true
    min_length = 50

    preprocess_method = 'itsxpress'
    analysis_mode = 'paired'

    primer_fwd = 'GTGARTCATCGAATCTTTG'
    primer_rev = 'TCCTCCGCTTATTGATATGC'
    primer_fwd_adapter = 'GCATATCAATAAGCGGAGGA'
    primer_rev_adapter = 'CAAAGATTCGATGAYTCAC'
    primer_discard_untrimmed = false

    itsxpress_region = 'ITS2'
    itsxpress_taxa = 'F'
    itsxpress_cluster_id = 1.0

    dada2_trim_left_f = 0
    dada2_trim_left_r = 0
    dada2_trunc_len_f = 0
    dada2_trunc_len_r = 0
    dada2_max_ee_f = 2.0
    dada2_max_ee_r = 2.0

    dada2_trim_left = 0
    dada2_trunc_len = 0
    dada2_max_ee = 2.0

    dada2_trunc_q = 2
    dada2_min_overlap = 12
    dada2_max_merge_mismatch = 0
    dada2_trim_overhang = false
    dada2_pooling_method = 'independent'
    dada2_chimera_method = 'consensus'
    dada2_n_reads_learn = 1000000

    taxonomy_enabled = true
    taxonomy_qiime_sif = null
    taxonomy_reads_per_batch = 'auto'
    taxonomy_confidence = 0.7

    blast_refseq_enabled = true
    blast_retrieval_n = 20
    blast_top_n = 5
    blast_max_evalue = 1e-10
    blast_min_pident = 99.0
    blast_min_qcovus = 99.0
    blast_min_qiime_confidence = 0.7

    blast_reconcile_mode = 'species_missing_rescue'
    blast_species_min_pident = 99.0
    blast_species_min_qcovus = 99.0
    blast_species_max_evalue = 1e-10

    taxonomy_profile = 'unite'
}

executor {
    name = 'local'
    queueSize = 72
    pollInterval = '2 sec'
}

process {
    executor = 'local'
    shell = ['/bin/bash', '-euo', 'pipefail']

    /*
     * Default resources for small helper processes.
     */
    cpus = 2
    memory = '8 GB'
    time = '12 h'

    /*
     * Many independent FASTQC tasks.
     * Keep cpus small and allow enough parallelism.
     * 24 tasks x 2 cpus = 48 cpus.
     */
    withLabel: qc {
        cpus = 2
        memory = '4 GB'
        maxForks = 16
    }

    /*
     * Cutadapt cleanup is moderately parallel.
     * 16 tasks x 4 cpus = 64 cpus.
     */
    withLabel: read_cleanup {
        cpus = 4
        memory = '8 GB'
        maxForks = 16
    }

    /*
     * QIIME import is I/O and temporary-file heavy.
     */
    withLabel: qiime_import {
        cpus = 8
        memory = '32 GB'
        maxForks = 4
    }

    /*
     * ITSxpress / primer trimming inside QIIME.
     */
    withLabel: qiime_preprocess {
        cpus = 16
        memory = '64 GB'
        maxForks = 2
    }

    /*
     * DADA2 is usually the main bottleneck.
     */
    withLabel: qiime_dada2 {
        cpus = 32
        memory = '160 GB'
        maxForks = 1
    }

    /*
     * sklearn taxonomy can benefit from more CPU and RAM.
     */
    withLabel: qiime_taxonomy {
        cpus = 32
        memory = '192 GB'
        maxForks = 1
    }

    withLabel: qiime_taxonomy_import {
        cpus = 8
        memory = '32 GB'
        maxForks = 2
    }

    /*
     * BLAST is CPU-heavy. Keep one BLAST job at a time for stable server use.
     */
    withLabel: blast_taxonomy {
        cpus = 40
        memory = '192 GB'
        maxForks = 1
    }
}

singularity {
    enabled = true
    autoMounts = true
    runOptions = '-B /data:/data -B /data/home2:/data/home2 -B /home:/home'
}